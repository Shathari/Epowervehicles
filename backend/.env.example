# SQLite for local dev. Swap to a Postgres connection string for production —
# Prisma's schema/queries don't need to change, just this URL and the datasource provider.
DATABASE_URL="file:./dev.db"

NODE_ENV=development
PORT=4000
# Origin(s) allowed to call this API with credentials (the deployed frontend URL in production)
CORS_ORIGIN=http://localhost:5173

# Use long, random secrets in production (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Seeded as the first admin user (prisma/seed.ts) — change the password after first login
ADMIN_EMAIL=admin@epowervehicles.com
ADMIN_PASSWORD=

# Optional: SMTP notification email sent to NOTIFY_TO_EMAIL on new contact/dealership
# submissions. Leave blank to disable — the app works fine without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_TO_EMAIL=

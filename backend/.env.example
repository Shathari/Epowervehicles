# Copy to backend/.env for local development and fill in the blanks.
# In production (Render, etc.) do NOT use a .env file — set these as real environment
# variables in your platform's dashboard instead. See README.md#deployment-environment-variables
# for a full explanation of every variable below.

# ============================= Core =============================

NODE_ENV=development
PORT=4000

# Origin(s) allowed to call this API with credentials — the deployed frontend's URL in production,
# e.g. https://epowervehicles.com
CORS_ORIGIN=http://localhost:5173

# Postgres connection string. Local dev and production both point at Postgres (Neon) — Prisma
# connects via the `@prisma/adapter-pg` driver adapter (backend/src/config/prisma.ts), which
# works fine with Neon's pooled connection string (the "-pooler" host).
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# ======================== Auth (JWT) — required ========================
# Generate long, random secrets for these — e.g. `openssl rand -hex 32` — and never reuse the
# same value for both. Required in every environment, including production.

JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-16-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-at-least-16-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ================== First-time admin account — required ==================
# Used once by `prisma/seed.ts` to create the initial ADMIN user your external dashboard logs
# in with via POST /api/auth/login. Change the password after first login; these variables can
# stay set afterwards without effect (seeding is a no-op if a user already exists).

ADMIN_EMAIL=admin@epowervehicles.com
ADMIN_PASSWORD=ReplaceWithAStrongPassword123!

# Optional: lets ADMIN_EMAIL log in as a virtual admin (authService.ts) without needing a row in
# the users table — works even if the table is empty. Set to a bcrypt hash of the admin password,
# e.g. via `node -e "console.log(require('bcryptjs').hashSync('yourPassword', 12))"`. Leave unset
# to keep relying solely on the Prisma-seeded user (existing behavior).
ADMIN_PASSWORD_HASH=

# ==================== Optional: SMTP email notifications ====================
# Sends a notification email to NOTIFY_TO_EMAIL whenever a new contact message, dealership
# application, or sales partner application is submitted. Leave every one of these blank/unset
# to disable notifications — the app works fine without them.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_TO_EMAIL=
